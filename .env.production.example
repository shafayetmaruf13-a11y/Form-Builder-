# Copy to `.env.production` on the server and fill in.
#
#   cp .env.production.example .env.production
#
# `.env.production` is gitignored and must stay that way — it holds the secret
# that signs every session. Never commit it, and never bake it into an image:
# a layer keeps what you deleted.

# --- Required ---------------------------------------------------------------

# Your OCI managed PostgreSQL. `sslmode=require` is not optional on a network
# you do not own; `verify-full` is better still if you have the CA on the host.
DATABASE_URL=postgres://formcraft:CHANGE_ME@your-db-host.postgresql.region.oci.oraclecloud.com:5432/formcraft?sslmode=require

# Signs sessions and the PDF worker's render tokens. Generate a fresh one:
#   openssl rand -base64 32
# Changing it signs everybody out and invalidates sign-in links in flight.
AUTH_SECRET=CHANGE_ME

# The public hostname. Caddy gets its certificate for exactly this name, and
# Auth.js builds sign-in links from it.
FORMCRAFT_DOMAIN=forms.example.com
AUTH_URL=https://forms.example.com

# --- Email (Slice 8) --------------------------------------------------------

# Unset, nothing is sent: messages are written to the container log and
# recorded in email_log as `logged`. Fine for a first deploy — and better than
# half-configured mail, which fails silently in the other direction.
# RESEND_API_KEY=
# EMAIL_FROM="Formcraft <forms@example.com>"
# RESEND_WEBHOOK_SECRET=

# See docs/email-dns.md for the SPF, DKIM and DMARC records. They are yours to
# add to your domain; nothing in this repo touches DNS.

# --- Anti-abuse (architecture rule 6) ---------------------------------------

# Strongly recommended before a link is circulated. Public fill pages are
# rate limited either way, but Turnstile is what stops a bot that is patient.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Not needed on this deployment ------------------------------------------

# AUTH_DEV_BYPASS is refused in production regardless of its value. It is here
# only so nobody wastes an afternoon wondering why setting it did nothing.
#
# RENDER_ORIGIN and UPLOADS_DIR are set by docker-compose.prod.yml, which knows
# the container's own address and where the volume is mounted.
#
# CHROMIUM_EXECUTABLE_PATH is baked into the image: the distribution's Chromium
# at /usr/bin/chromium.
