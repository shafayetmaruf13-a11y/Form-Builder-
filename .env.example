# Copy to `apps/web/.env` and fill in. Never commit the filled-in file.
#
# Every variable the project will eventually need is listed here, tagged with
# the slice that switches it on, so no slice surprises you with a new one.

# --- Slice 0 ---------------------------------------------------------------

# Matches docker-compose.yml. Change only if you run Postgres elsewhere.
DATABASE_URL=postgres://formcraft:formcraft@localhost:5432/formcraft

# The single hardcoded user that owns everything until real auth lands.
# Seeded by `pnpm db:migrate`.
DEV_USER_ID=dev_user_000000000001
DEV_USER_EMAIL=dev@formcraft.local

# Where local-disk object storage keeps uploads in development. Replaced by
# Cloudflare R2 at Slice 5; the document only ever stores an object key, so
# that swap needs no schema change.
UPLOADS_DIR=.uploads

# --- Slice 4 (publish and fill) --------------------------------------------

# Public origin used to build share links, e.g. https://formcraft.example.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile, protecting public fill pages from bots.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Slice 4/5 (uploads and PDF storage) -----------------------------------

# S3-compatible object storage (Cloudflare R2), accessed via the AWS SDK.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=formcraft
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=

# Shared secret the app sends to its own PDF worker route, so nothing else can
# trigger a render.
# PDF_WORKER_SECRET=

# --- Slice 7 (email) -------------------------------------------------------

# RESEND_API_KEY=
# EMAIL_FROM="Formcraft <noreply@example.com>"
# Verifies that inbound bounce/delivery webhooks really came from Resend.
# RESEND_WEBHOOK_SECRET=
