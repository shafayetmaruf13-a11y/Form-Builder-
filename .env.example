# Copy to `apps/web/.env` and fill in. Never commit the filled-in file.
#
# Every variable the project will eventually need is listed here, tagged with
# the slice that switches it on, so no slice surprises you with a new one.

# --- Slice 0 ---------------------------------------------------------------

# Matches docker-compose.yml. Change only if you run Postgres elsewhere.
DATABASE_URL=postgres://formcraft:formcraft@localhost:5432/formcraft

# The single hardcoded user that owns everything until real auth lands.
# Seeded by `pnpm db:migrate`.
DEV_USER_ID=dev_user_000000000001
DEV_USER_EMAIL=dev@formcraft.local

# Where local-disk object storage keeps uploads in development. Replaced by
# Cloudflare R2 at Slice 5; the document only ever stores an object key, so
# that swap needs no schema change.
UPLOADS_DIR=.uploads

# --- Slice 4 (accounts and access) -----------------------------------------

# Signs session cookies. Generate with: openssl rand -base64 32
# Required in every environment; Auth.js refuses to start without it.
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Only needed if the app is not at http://localhost:3000
# AUTH_URL=https://forms.example.com

# Believe the request's Host header. Required in production unless AUTH_URL is
# set, because the host decides where a sign-in link points — a forged header
# on a trusting deployment sends somebody's magic link to an attacker. Set this
# only behind a proxy whose Host you control.
# AUTH_TRUST_HOST=true

# Signs you in as the seeded dev user without an email round trip. Refused in
# production regardless of this value. Leave unset unless you want it.
# AUTH_DEV_BYPASS=true

# Sends the sign-in links. Without it, links are printed to the dev server's
# console, which is enough to work locally.
# RESEND_API_KEY=
# EMAIL_FROM="Formcraft <noreply@example.com>"

# --- Slice 5 (publish and fill) --------------------------------------------

# Nothing is required here — publishing and filling work with none of it set.
#
# There is deliberately no APP_URL. Share links are built from the origin the
# owner actually reached the app on (`window.location.origin`), because an
# environment variable is how share links end up pointing at localhost.

# Cloudflare Turnstile, protecting public fill pages from bots.
#
# Both together turn it on: the site key renders the widget, the secret makes
# the submit endpoint require a valid token. Neither is NEXT_PUBLIC_, because
# the site key is read on the server and passed to the page as a prop — one
# fewer build-time variable to get wrong.
#
# Left unset in development: challenges.cloudflare.com is refused by this
# container's network policy, so the widget could not load anyway. The
# verification code is written and runs whenever the secret is present, and
# fails *closed* if Cloudflare cannot be reached.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Slice 4/5 (uploads and PDF storage) -----------------------------------

# S3-compatible object storage (Cloudflare R2), accessed via the AWS SDK.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=formcraft
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=

# Shared secret the app sends to its own PDF worker route, so nothing else can
# trigger a render.
# PDF_WORKER_SECRET=

# --- Slice 7 (email) -------------------------------------------------------

# RESEND_API_KEY=
# EMAIL_FROM="Formcraft <noreply@example.com>"
# Verifies that inbound bounce/delivery webhooks really came from Resend.
# RESEND_WEBHOOK_SECRET=
