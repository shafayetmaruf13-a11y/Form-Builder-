{
  "name": "formcraft",
  "version": "0.0.0",
  "private": true,
  "description": "Canvas-based form builder: design a form freely on an A4 page, publish it as a link, get submissions back as pixel-accurate PDF, Excel or email.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @formcraft/web dev",
    "build": "pnpm --filter @formcraft/web build",
    "start": "pnpm --filter @formcraft/web start",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @formcraft/web db:generate",
    "db:migrate": "pnpm --filter @formcraft/web db:migrate",
    "db:studio": "pnpm --filter @formcraft/web db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3"
  }
}
